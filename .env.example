# 复制为 .env 后填入真实值。.env 已被 gitignore，不会入库。
#
#     cp .env.example .env
#
# 配置项的读取见 src/derivrag/config.py —— configs/config.yaml 里的
# ${VAR} 会在加载时从环境变量插值。

# 生成模型。configs/config.yaml 默认 llm.provider: deepseek
# 申请地址 https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：改用 OpenAI 兼容端点时填这个（同时把 provider 改成 openai）
# OPENAI_API_KEY=

# 可选：Streamlit 访问后端的地址。
# 本地直接跑用默认值即可；docker compose 里由 compose 注入 http://api:8000
# DERIVRAG_API_URL=http://127.0.0.1:8000
